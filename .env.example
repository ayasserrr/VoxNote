# =====================================================================
#  VoxNote configuration — copy to `.env` and fill in at least ONE key.
#  All providers below have FREE tiers. No credit card required.
# =====================================================================

# ---------------------------------------------------------------------
# 1) AI language models — 100% FREE (no paid keys, no credit card)
# ---------------------------------------------------------------------
# You need at least ONE free key below; two or more is better (automatic fallback
# when a free tier hits its limit). Check your keys any time with:
#     cd backend && .venv/bin/python -m app.check_ai     (Windows: .venv\Scripts\python -m app.check_ai)
# or the "Test my AI keys" button on the Settings page.
#
# Providers are tried IN ORDER. Providers without a key are skipped.
# Options: groq, gemini, cerebras, mistral, openrouter, ollama, openai_compat, mock
LLM_PROVIDERS=groq,gemini,cerebras,mistral,openrouter,ollama

# MODEL NAMES: leave "auto". VoxNote reads each provider's live model list and
# picks the best FREE chat models, so retired models (e.g. llama-3.3-70b-versatile,
# retired by Groq in Aug 2026, or Gemini 2.5, retired in Oct 2026) are replaced
# automatically. To pin models, give a comma-separated list instead of "auto".

# Groq — free tier, no credit card, very fast. https://console.groq.com/keys
# The SAME key also gives free Whisper speech-to-text (section 2).
GROQ_API_KEY=
GROQ_MODEL=auto
# e.g. GROQ_MODEL=openai/gpt-oss-120b,qwen/qwen3-32b,openai/gpt-oss-20b

# Google Gemini — free tier, no credit card, excellent Arabic. https://aistudio.google.com/apikey
# (The Gemini free tier is not offered in the EU/UK/Switzerland.)
GEMINI_API_KEY=
GEMINI_MODEL=auto
# e.g. GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest

# Cerebras — free tier, no credit card, extremely fast. https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=auto

# Mistral — free "Experiment" plan (phone verification, no card). https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=auto

# OpenRouter — ":free" models at $0 (≈50 requests/day if you never bought credits). https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Ollama — runs on YOUR computer: unlimited, private, offline. https://ollama.com
# 1) install Ollama  2) `ollama pull qwen2.5:7b` (or qwen3:8b)  3) set OLLAMA_ENABLED=true
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=auto

# Any other OpenAI-compatible server you run yourself (LM Studio, llama.cpp, vLLM, ...)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Generation tuning
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=8192
# How many free models to rotate per provider (free quotas are usually per model)
LLM_MODELS_PER_PROVIDER=3
# Reasoning models (gpt-oss, Gemini 3): low keeps answers fast and within free limits
LLM_REASONING_EFFORT=low
# Seconds to wait between LLM calls. 2-4 keeps long courses/playlists smooth on free tiers.
LLM_MIN_INTERVAL=2

# ---------------------------------------------------------------------
# 2) Speech-to-text (used when a video has no captions, and for uploads)
# ---------------------------------------------------------------------
# groq  = Whisper large-v3 on Groq (free tier, uses GROQ_API_KEY)
# local = faster-whisper on your machine (`pip install faster-whisper`)
# none  = captions only
STT_PROVIDER=groq
GROQ_STT_MODEL=whisper-large-v3
# (if this model is ever retired, VoxNote falls back to whisper-large-v3-turbo automatically)
LOCAL_WHISPER_MODEL=small
# Download the audio of videos without captions (personal use; respect content rights)
ALLOW_AUDIO_DOWNLOAD=true

# ---------------------------------------------------------------------
# 3) YouTube access
# ---------------------------------------------------------------------
# Cloud servers are often blocked by YouTube. If captions fail with
# "RequestBlocked"/"IpBlocked", route requests through a proxy.
YOUTUBE_PROXY_URL=
# Optional cookies.txt (Netscape format) for age-restricted videos
YOUTUBE_COOKIES_FILE=
MAX_PLAYLIST_VIDEOS=200
PREFERRED_CAPTION_LANGUAGES=en,ar,en-US,en-GB,ar-EG,ar-SA

# ---------------------------------------------------------------------
# 4) App / security
# ---------------------------------------------------------------------
# CHANGE THIS for any non-local deployment: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
ALLOW_REGISTRATION=true
LOG_LEVEL=INFO

# Database: SQLite by default (zero setup). docker-compose uses PostgreSQL.
# DATABASE_URL=postgresql+psycopg://voxnote:voxnote@localhost:5432/voxnote

# Background jobs: "thread" (in-process, zero setup) or "celery" (needs Redis)
TASK_BACKEND=thread
WORKER_CONCURRENCY=2
MAX_RETRIES=3
# REDIS_URL=redis://localhost:6379/0

# Pipeline
CHUNK_MAX_TOKENS=2500

# ---------------------------------------------------------------------
# 5) Learning Hub (documentation courses & quizzes)
# ---------------------------------------------------------------------
# Share of quiz points needed to complete a lesson and unlock the next one
QUIZ_PASS_SCORE=0.7
# Politeness delay between documentation page requests (seconds)
CRAWL_DELAY=0.3
CRAWL_MAX_PAGES=300
# Generate the next lesson in the background while you study the current one
PREFETCH_NEXT_LESSON=true

# Storage: local (default) or s3 (any S3-compatible bucket; `pip install boto3`)
STORAGE_BACKEND=local
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
