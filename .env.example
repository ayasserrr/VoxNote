# =====================================================================
#  VoxNote configuration — copy to `.env` and fill in at least ONE key.
#  All providers below have FREE tiers. No credit card required.
# =====================================================================

# ---------------------------------------------------------------------
# 1) AI language models (knowledge extraction + "Ask your playlist")
# ---------------------------------------------------------------------
# Providers are tried IN ORDER; if one is rate-limited or down, VoxNote
# automatically falls back to the next one that has a key.
# Options: groq, gemini, openrouter, ollama, openai_compat, mock
LLM_PROVIDERS=groq,gemini,openrouter,ollama

# Groq — free tier, extremely fast. https://console.groq.com/keys
# The same key also unlocks FREE Whisper speech-to-text (see section 2).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Other free Groq models: openai/gpt-oss-120b, qwen/qwen3-32b, meta-llama/llama-4-scout-17b-16e-instruct

# Google Gemini — free tier, large context, very good Arabic. https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Cheaper/faster free alternative: gemini-2.5-flash-lite

# OpenRouter — dozens of ":free" models. https://openrouter.ai/keys
# "openrouter/free" automatically routes to an available free model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Ollama — 100% local & offline, unlimited and free. https://ollama.com
# 1) install Ollama  2) `ollama pull qwen2.5:7b`  3) set OLLAMA_ENABLED=true
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# Any other OpenAI-compatible server (LM Studio, vLLM, Together, ...)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Generation tuning
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=4096
# Seconds to wait between LLM calls. Free tiers have per-minute limits;
# 2-4 s keeps long playlists smooth on Groq's free tier.
LLM_MIN_INTERVAL=2

# ---------------------------------------------------------------------
# 2) Speech-to-text (used when a video has no captions, and for uploads)
# ---------------------------------------------------------------------
# groq  = Whisper large-v3 on Groq (free tier, uses GROQ_API_KEY)
# local = faster-whisper on your machine (`pip install faster-whisper`)
# none  = captions only
STT_PROVIDER=groq
GROQ_STT_MODEL=whisper-large-v3
LOCAL_WHISPER_MODEL=small
# Download the audio of videos without captions (personal use; respect content rights)
ALLOW_AUDIO_DOWNLOAD=true

# ---------------------------------------------------------------------
# 3) YouTube access
# ---------------------------------------------------------------------
# Cloud servers are often blocked by YouTube. If captions fail with
# "RequestBlocked"/"IpBlocked", route requests through a proxy.
YOUTUBE_PROXY_URL=
# Optional cookies.txt (Netscape format) for age-restricted videos
YOUTUBE_COOKIES_FILE=
MAX_PLAYLIST_VIDEOS=200
PREFERRED_CAPTION_LANGUAGES=en,ar,en-US,en-GB,ar-EG,ar-SA

# ---------------------------------------------------------------------
# 4) App / security
# ---------------------------------------------------------------------
# CHANGE THIS for any non-local deployment: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
ALLOW_REGISTRATION=true
LOG_LEVEL=INFO

# Database: SQLite by default (zero setup). docker-compose uses PostgreSQL.
# DATABASE_URL=postgresql+psycopg://voxnote:voxnote@localhost:5432/voxnote

# Background jobs: "thread" (in-process, zero setup) or "celery" (needs Redis)
TASK_BACKEND=thread
WORKER_CONCURRENCY=2
MAX_RETRIES=3
# REDIS_URL=redis://localhost:6379/0

# Pipeline
CHUNK_MAX_TOKENS=2500

# ---------------------------------------------------------------------
# 5) Learning Hub (documentation courses & quizzes)
# ---------------------------------------------------------------------
# Share of quiz points needed to complete a lesson and unlock the next one
QUIZ_PASS_SCORE=0.7
# Politeness delay between documentation page requests (seconds)
CRAWL_DELAY=0.3
CRAWL_MAX_PAGES=300
# Generate the next lesson in the background while you study the current one
PREFETCH_NEXT_LESSON=true

# Storage: local (default) or s3 (any S3-compatible bucket; `pip install boto3`)
STORAGE_BACKEND=local
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
